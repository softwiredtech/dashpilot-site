# Developer early access ordering is OPEN by default (since 2026-07-31).
# Set to "false" to close checkout again — /order then shows price and
# availability with no payment button, and /api/checkout refuses sessions.
# NEXT_PUBLIC_ORDERS_OPEN=false

# Stripe secret key — server-side only, never exposed to the browser.
# Use a test key (sk_test_...) for local development.
STRIPE_SECRET_KEY=sk_test_xxx

# DashKit price in EUR (whole euros), excluding VAT. Shown on /order and used
# as the Stripe line-item amount.
NEXT_PUBLIC_PRICE_EUR=139

# Umami analytics. Both of these are optional overrides — the live website ID
# and Umami Cloud's script URL are baked into app/layout.tsx, and the tracker
# only loads in production builds (not dev, not preview deploys).
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=27ed861b-b19d-43c8-9854-db8c905fb822
# NEXT_PUBLIC_UMAMI_SRC=https://analytics.example.com/script.js

# Google Ads. The conversion ID (AW-18389147141) is baked into lib/gtag.ts;
# this is an optional override. The tag only loads in production builds (not
# dev, not preview deploys) and only after the visitor accepts cookies.
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18389147141
# Conversion labels: the part after the slash in a conversion action's
# send_to: 'AW-.../<label>'. A conversion with no label set is not sent.
# NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
# NEXT_PUBLIC_GOOGLE_ADS_BEGIN_CHECKOUT_LABEL=
# Load the banner and tag in `next dev` to test them locally.
# NEXT_PUBLIC_ADS_DEBUG=true
