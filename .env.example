# Stripe secret key — server-side only, never exposed to the browser.
# Use a test key (sk_test_...) for local development.
STRIPE_SECRET_KEY=sk_test_xxx

# Stripe webhook signing secret. Local: run `stripe listen --forward-to
# localhost:3000/api/webhooks/stripe` and copy the whsec_... it prints.
# Production: Stripe Dashboard -> Webhooks -> your endpoint -> reveal signing secret.
# These are different values; the CLI one only works while the CLI is running.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# DashKit price in EUR (whole euros). Placeholder — adjust before going live.
NEXT_PUBLIC_PRICE_EUR=149

# Easyship API token. Dashboard -> Connect -> New Integration -> API Integration.
# Sandbox tokens start with sand_, production with prod_.
# Needs scopes: public.rate:read, public.shipment:write, public.reference:read
EASYSHIP_API_KEY=sand_xxx

# "production" hits public-api.easyship.com; anything else uses the sandbox host.
EASYSHIP_ENV=sandbox

# Only offer rates from this courier brand. Empty string shows every courier,
# which is useful in sandbox where UPS services are often missing.
EASYSHIP_COURIER_UMBRELLA=UPS

# Optional HS tariff code for customs. Unused while shipping EU-only.
# EASYSHIP_HS_CODE=851762

# Resend API key for order confirmation emails.
RESEND_API_KEY=re_xxx

# Verified sending identity. The domain must be verified in Resend first —
# the onboarding@resend.dev fallback can only email your own account address.
RESEND_FROM="DashKit <orders@softwiredtech.com>"
